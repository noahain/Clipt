{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipt",
  "version": "2.0.1",
  "identifier": "com.clipt.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipt",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/Clipt/media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQjgxNjg2MUM3NUEwRUIKUldUcm9IVWNoaGE0L1R1b2NsQnl1VXpzSXJqQjh2MG9wc3o0L3AweG41eXlldkw2czNMM0dpK1AK",
      "endpoints": [
        "https://github.com/noahain/clipt/releases/latest/download/latest.json"
      ]
    }
  }
}
